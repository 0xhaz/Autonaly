# Agent runtime — Cloud Run services #2 (agent HTTP API) and #3 (Pub/Sub worker).
#
# The mirror image of Dockerfile.engine: this one DOES carry google-genai and
# ADK, because reasoning is its job. Both CMDs ship in one image because the
# worker and the personalization API share the same code and differ only in
# entrypoint — the deploy chooses.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/autonaly_core/pyproject.toml packages/autonaly_core/
COPY packages/autonaly_engine/pyproject.toml packages/autonaly_engine/
COPY packages/autonaly_pipeline/pyproject.toml packages/autonaly_pipeline/
COPY packages/autonaly_agent/pyproject.toml packages/autonaly_agent/
COPY packages/autonaly_ingest/pyproject.toml packages/autonaly_ingest/
COPY packages/autonaly_mcp/pyproject.toml packages/autonaly_mcp/

COPY packages/ packages/

# autonaly-ingest pulls autonaly-agent (and core) — one install serves the
# worker and the agent API.
RUN uv sync --frozen --package autonaly-ingest --no-dev

ENV PATH="/app/.venv/bin:$PATH"
ENV PORT=8090
EXPOSE 8090

# Default: the agent HTTP surface. The worker deployment overrides this.
CMD ["sh", "-c", "uvicorn autonaly_agent.api:app --host 0.0.0.0 --port ${PORT}"]
