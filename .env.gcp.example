# Cutover config (workplan.md §3 P6). Copy to .env.gcp — which is gitignored.
# Note what is NOT here: no emulator host vars. Their absence is the entire
# difference between local and cloud for Pub/Sub and Firestore.

AUTONALY_ENV=gcp
AUTONALY_PROJECT_ID=autonaly-hackathon
AUTONALY_LOCATION=us-central1
AUTONALY_ARTIFACT_BUCKET=autonaly-artifacts
AUTONALY_ENGINE_URL=https://autonaly-engine-XXXXX.us-central1.run.app

GOOGLE_CLOUD_PROJECT=autonaly-hackathon
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=us-central1
