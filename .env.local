# Local development. Committed on purpose — no secrets here.
# The emulator host vars are what make the Pub/Sub and Firestore client
# libraries talk to Docker instead of GCP (workplan.md §1).

AUTONALY_ENV=local
AUTONALY_PROJECT_ID=autonaly-hackathon
AUTONALY_LOCATION=us-central1
AUTONALY_ENGINE_URL=http://localhost:8080

# Gemini 3.x is served from the `global` endpoint and 404s in us-central1.
AUTONALY_VERTEX_LOCATION=global
AUTONALY_GEMINI_MODEL=gemini-3.7-flash

PUBSUB_EMULATOR_HOST=localhost:8085
FIRESTORE_EMULATOR_HOST=localhost:8086
GOOGLE_CLOUD_PROJECT=autonaly-hackathon

# Vertex has no emulator — these hit the real API in every environment.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=global
